# URL to monitor
TARGET_URL=https://myutilities.rockymountnc.gov/app/login.jsp

# Telegram Bot Credentials
# Get your BOT token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Get your chat ID from @userinfobot or @raw_data_bot on Telegram
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Check interval in seconds (default: 60)
CHECK_INTERVAL_SECONDS=60

# Number of consecutive failures/successes required before sending an alert (default: 2)
CONSECUTIVE_THRESHOLD=2

# Request timeout in seconds (default: 10)
REQUEST_TIMEOUT_SECONDS=10
